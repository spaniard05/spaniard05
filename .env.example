# Supabase project URL and public anon key (safe to expose to the browser).
# Find these in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key with elevated privileges. NEVER prefix this with NEXT_PUBLIC_
# and never import it from client components. Only used in trusted server
# contexts (e.g. one-off admin scripts); the app itself does not require it
# for normal operation because RLS handles authorization.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Used to auto-estimate meal macros when you save a meal
# without filling them in yourself. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only. Google Cloud OAuth client for two-way Google Calendar sync
# (tasks + assignments with due dates). Create one at
# https://console.cloud.google.com/apis/credentials - see README for the
# full walkthrough (enable Calendar API, configure consent screen, add
# yourself as a test user, set the redirect URI below as an authorized one).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g.
# http://localhost:3000/auth/google/callback for local dev, or
# https://your-app.vercel.app/auth/google/callback in production.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
